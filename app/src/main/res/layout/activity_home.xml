<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">



    <!-- ========================= -->
    <!-- FRAGMENT MEDICAMENTOS -->
    <!-- ========================= -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_medicamentos_container"
        android:name="com.codarini.ojeda.parcial1.ui.medicamentos.MedicamentosFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/include_resumen_salud"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ========================= -->
    <!-- RESUMEN SALUD -->
    <!-- ========================= -->
    <include
        android:id="@+id/include_resumen_salud"
        layout="@layout/view_resumen_salud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- FAB
    <com.google.android.material.floatingactionbutton.FloatingActionButton
